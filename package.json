{
  "name": "loyal-cart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A checkout a bribe can't change: pays only the best-scoring offer under the buyer's committed policy.",
  "scripts": {
    "verify": "node packages/verifier/verify.mjs --fixture fixtures/arena.json",
    "arena": "node packages/arena/arena.mjs --fixture fixtures/arena.json",
    "arena:testnet": "node scripts/testnet/replay.mjs",
    "ui": "node scripts/serve.mjs",
    "test": "node --test packages/verifier/test/*.test.mjs packages/arena/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
